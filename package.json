{
    "name": "yee-mobile",
    "version": "2.0.0-rc.22-1772903013031",
    "private": true,
    "main": "expo-router/entry",
    "scripts": {
        "dev": "bunx expo start --dev-client --tunnel",
        "upgrade:tamagui": "bunx npm-check-updates -u '*tamagui*' '@tamagui/*' && bun install",
        "start": "bunx expo start -c",
        "android": "expo run:android",
        "ios": "expo run:ios --no-build-cache",
        "build": "expo export --platform all",
        "build:android": "expo export --platform android",
        "build:ios": "expo export --platform ios",
        "eas:android": "eas build --platform android --profile production --wait",
        "eas:android:local": "eas build --platform android --profile production --local --wait",
        "eas:ios": "eas build --platform ios --profile production --wait",
        "eas:ios:local": "eas build --platform ios --profile production --local --wait",
        "update:production": "eas update --channel production --environment production --message \"Production update\"",
        "submit:android": "eas submit --platform android --profile production --latest",
        "submit:ios": "eas submit --platform ios --profile production --latest",
        "release:android": "bun run eas:android && bun run submit:android",
        "release:android:local": "bun run eas:android:local && bun run submit:android",
        "release:ios": "bun run eas:ios && bun run submit:ios",
        "release:ios:local": "bun run eas:ios:local && bun run submit:ios",
        "version:show": "node scripts/bump-version.mjs --show",
        "version:patch": "node scripts/bump-version.mjs --patch",
        "version:minor": "node scripts/bump-version.mjs --minor",
        "doctor": "npx expo-doctor",
        "test": "npx playwright test",
        "test:unit": "vitest run",
        "test:e2e": "npx playwright test",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . --cache",
        "lint:fix": "eslint . --cache --fix",
        "format": "prettier . --write --ignore-unknown",
        "format:check": "prettier . --check --ignore-unknown",
        "check": "bun run typecheck && bun run lint && bun run format:check",
        "screenshots:ios": "node scripts/capture-screenshots.mjs --platform ios",
        "screenshots:android": "node scripts/capture-screenshots.mjs --platform android",
        "screenshots": "bun run screenshots:ios && bun run screenshots:android",
        "ci:quality": "bun run check && bun run doctor",
        "prepare": "husky"
    },
    "resolutions": {
        "@babel/core": "7.29.7",
        "@babel/helper-create-class-features-plugin": "7.29.7",
        "@babel/plugin-transform-class-static-block": "7.29.7"
    },
    "dependencies": {
        "@expo-google-fonts/geist": "^0.4.2",
        "@expo-google-fonts/jetbrains-mono": "^0.4.1",
        "@posthog/react-native-plugin": "^2.1.2",
        "@react-native-async-storage/async-storage": "2.2.0",
        "@react-native-community/netinfo": "11.5.2",
        "@react-navigation/native": "^7.1.33",
        "@sentry/react-native": "~7.11.0",
        "@tamagui/animations-react-native": "2.7.7",
        "@tamagui/config": "2.4.2",
        "@tamagui/helpers-icon": "2.4.2",
        "@tamagui/lucide-icons-2": "2.4.2",
        "@tamagui/sizable-context": "2.4.2",
        "@tamagui/toast": "2.4.2",
        "babel-preset-expo": "~55.0.23",
        "burnt": "^0.12.2",
        "expo": "~55.0.29",
        "expo-application": "~55.0.18",
        "expo-build-properties": "~55.0.17",
        "expo-constants": "~55.0.17",
        "expo-dev-client": "~55.0.38",
        "expo-device": "~55.0.20",
        "expo-file-system": "~55.0.25",
        "expo-font": "~55.0.8",
        "expo-linking": "~55.0.17",
        "expo-localization": "~55.0.18",
        "expo-navigation-bar": "~55.0.16",
        "expo-router": "~55.0.18",
        "expo-secure-store": "~55.0.17",
        "expo-splash-screen": "~55.0.24",
        "expo-status-bar": "~55.0.6",
        "expo-system-ui": "~55.0.21",
        "expo-updates": "~55.0.27",
        "expo-web-browser": "~55.0.19",
        "patch-package": "^8.0.1",
        "posthog-react-native": "^4.54.5",
        "react": "19.2.0",
        "react-dom": "19.2.0",
        "react-native": "0.83.10",
        "react-native-keyboard-controller": "1.20.7",
        "react-native-mmkv": "^4.3.2",
        "react-native-nitro-modules": "^0.35.10",
        "react-native-reanimated": "4.2.1",
        "react-native-safe-area-context": "~5.6.2",
        "react-native-screens": "~4.23.0",
        "react-native-svg": "15.15.3",
        "react-native-view-shot": "4.0.3",
        "react-native-web": "^0.21.2",
        "react-native-worklets": "0.7.4",
        "tamagui": "2.4.2",
        "zod": "^4.4.3",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@babel/core": "7.29.7",
        "@babel/helper-create-class-features-plugin": "7.29.7",
        "@babel/plugin-transform-class-static-block": "7.29.7",
        "@expo/metro-runtime": "~55.0.12",
        "@playwright/test": "^1.61.1",
        "@tamagui/babel-plugin": "2.4.2",
        "@tamagui/cli": "2.4.2",
        "@types/react": "~19.2.17",
        "eslint": "^9.39.4",
        "eslint-config-expo": "^55.0.1",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "prettier": "^3.9.4",
        "serve": "^14.2.6",
        "typescript": "~5.9.3",
        "vitest": "^4.1.10"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "eslint --cache --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml}": "prettier --write --ignore-unknown"
    },
    "packageManager": "bun@1.3.14",
    "trustedDependencies": [
        "@sentry/cli"
    ],
    "expo": {
        "doctor": {
            "reactNativeDirectoryCheck": {
                "exclude": [
                    "posthog-react-native-session-replay"
                ],
                "listUnknownPackages": false
            }
        }
    }
}
