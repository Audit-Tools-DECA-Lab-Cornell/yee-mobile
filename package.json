{
    "name": "audit-tools-yee-mobile",
    "version": "2.0.0-rc.22-1772903013031",
    "private": true,
    "main": "expo-router/entry",
    "scripts": {
        "upgrade:tamagui": "bunx npm-check-updates -u '*tamagui*' '@tamagui/*' && bun install",
        "start": "bunx expo start -c",
        "android": "expo run:android",
        "ios": "expo run:ios",
        "web": "expo start --web",
        "build": "expo export --platform all",
        "build:web": "expo export --platform web",
        "build:android": "expo export --platform android",
        "build:ios": "expo export --platform ios",
        "doctor": "npx expo-doctor",
        "test": "npx playwright test",
        "test:web": "npx playwright test",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . --cache",
        "lint:fix": "eslint . --cache --fix",
        "format": "prettier . --write --ignore-unknown",
        "format:check": "prettier . --check --ignore-unknown",
        "check": "bun run typecheck && bun run lint && bun run format:check",
        "perf:web:budget": "node ./scripts/check-web-bundle-size.mjs",
        "ci:quality": "bun run check && bun run doctor",
        "prepare": "husky"
    },
    "resolutions": {
        "hermes-compiler": "250829098.0.1"
    },
    "dependencies": {
        "@expo-google-fonts/geist": "^0.4.1",
        "@expo-google-fonts/jetbrains-mono": "^0.4.1",
        "@expo-google-fonts/space-grotesk": "^0.4.1",
        "@react-native-async-storage/async-storage": "^3.0.2",
        "@react-native-community/netinfo": "^12.0.1",
        "@react-navigation/native": "^7.0.14",
        "@tamagui/config": "2.0.0-rc.41",
        "@tamagui/lucide-icons": "2.0.0-rc.7-1770543309730",
        "@tamagui/toast": "2.0.0-rc.41",
        "babel-preset-expo": "~55.0.8",
        "burnt": "^0.12.2",
        "expo": "^55.0.0",
        "expo-build-properties": "^55.0.9",
        "expo-constants": "~55.0.7",
        "expo-font": "~55.0.4",
        "expo-linking": "~55.0.7",
        "expo-router": "~55.0.4",
        "expo-secure-store": "~55.0.8",
        "expo-splash-screen": "~55.0.10",
        "expo-status-bar": "~55.0.4",
        "expo-system-ui": "~55.0.9",
        "expo-updates": "~55.0.12",
        "expo-web-browser": "~55.0.9",
        "patch-package": "^8.0.1",
        "react": "19.2.0",
        "react-dom": "19.2.0",
        "react-native": "0.83.2",
        "react-native-reanimated": "4.2.1",
        "react-native-safe-area-context": "~5.6.0",
        "react-native-screens": "~4.23.0",
        "react-native-svg": "15.15.3",
        "react-native-web": "^0.21.0",
        "react-native-worklets": "0.7.2",
        "tamagui": "2.0.0-rc.41",
        "zod": "^4.3.6",
        "zustand": "^5.0.11"
    },
    "devDependencies": {
        "@babel/core": "^7.25.2",
        "@expo/metro-runtime": "~55.0.6",
        "@playwright/test": "^1.49.1",
        "@tamagui/babel-plugin": "2.0.0-rc.41",
        "@types/react": "~19.2.10",
        "eslint": "^9.39.4",
        "eslint-config-expo": "^55.0.0",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "lint-staged": "^16.3.2",
        "prettier": "^3.8.1",
        "serve": "^14.2.5",
        "typescript": "~5.9.2"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "eslint --cache --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml}": "prettier --write --ignore-unknown"
    },
    "packageManager": "bun@1.3.9"
}
